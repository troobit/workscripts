# ====================================================================================
# Variables
# ====================================================================================

variable "jumphost_vm_image" {
  type = map
  default = {
    publisher = "MicrosoftWindowsDesktop"
    offer     = "windows10preview"
    sku       = "win10-22h2-avd"
    version   = "latest"
  }
}

variable "jh_count" {
  default = 1
}

# ====================================================================================
# Primary Location
# ====================================================================================

resource "azurerm_windows_virtual_machine" "ws" {
  count = var.jh_count
  name                                  = "ws-vm-${format("%02d", count.index + 1)}"
  admin_username                        = var.adminusername
  admin_password                        = var.password
  location                              = var.location
  resource_group_name                   = var.ingress_rg_name
  network_interface_ids                 = [azurerm_network_interface.jh_nic[count.index].id]
  size                                  = "Standard_B2s"

  source_image_reference {
    publisher                           = var.jumphost_vm_image.publisher
    offer                               = var.jumphost_vm_image.offer
    sku                                 = var.jumphost_vm_image.sku
    version                             = var.jumphost_vm_image.version
  }

  plan {
    name = "Hourly"
    publisher = var.jumphost_vm_image.publisher
    product = var.jumphost_vm_image.offer
  }

  os_disk {
    name                                = "jh-os-disk-${format("%02d", count.index + 1)}" 
    caching                             = "ReadWrite"
    storage_account_type                = "Standard_LRS"
  }

  tags                                  = var.common_tags
  depends_on                            = [azurerm_resource_group.ws_rg, azurerm_network_interface.ws_nic]
}